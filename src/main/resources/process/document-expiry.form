{
  "components": [
    {
      "type": "text",
      "id": "Field_document_expiry_form_T",
      "text": "## Documents overdue (30 days)\nRequired documents have not been received within 30 days.",
      "layout": {
        "row": "Row_1"
      }
    },
    {
      "type": "textfield",
      "id": "Field_document_expiry_form_E1",
      "key": "outstandingDocuments",
      "label": "Outstanding documents",
      "readonly": true,
      "layout": {
        "row": "Row_2"
      }
    },
    {
      "type": "radio",
      "id": "Field_document_expiry_form_E2",
      "key": "documentExpiryDecision",
      "label": "Decision",
      "values": [
        {
          "value": "EXTEND",
          "label": "Extend — wait another 30 days"
        },
        {
          "value": "CANCEL",
          "label": "Cancel application"
        }
      ],
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3"
      }
    },
    {
      "type": "textarea",
      "id": "Field_document_expiry_form_E3",
      "key": "documentExpiryNotes",
      "label": "Notes",
      "layout": {
        "row": "Row_4"
      }
    }
  ],
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  },
  "schemaVersion": 18,
  "id": "document_expiry_form"
}
