<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_general_workflow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="general_workflow" name="General Workflow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_applicationSubmitted" name="Application Submitted">
      <bpmn:documentation>Portal submission event; start instance with businessKey = applicationId.</bpmn:documentation>
      <bpmn:outgoing>Flow_start_createRecord</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_createApplicationRecord" name="Create Application Record">
      <bpmn:documentation>Create master record in Core Banking; persist applicationId as business key.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="createApplicationRecord" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="jms" />
          <zeebe:header key="targetStatus" value="SUBMITTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_createRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_createRecord_initChecklist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_createRecordFailed" name="Create record failed" attachedToRef="Task_createApplicationRecord">
      <bpmn:outgoing>Flow_createError_end</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_createRecordFailed" errorRef="Error_createRecordFailed" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_submissionFailed" name="Submission failed">
      <bpmn:documentation>Core banking could not create the application record; process ends without underwriting rejection handling.</bpmn:documentation>
      <bpmn:incoming>Flow_createError_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_initializeDocumentChecklist" name="Initialize Document Checklist">
      <bpmn:documentation>Build required document list from applicationType (General, LOC, etc.).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="initializeDocumentChecklist" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="rest" />
          <zeebe:header key="targetStatus" value="IN_REVIEW" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_createRecord_initChecklist</bpmn:incoming>
      <bpmn:outgoing>Flow_initChecklist_parallelSplit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_parallelSplit" name="Split eDocs / Credit">
      <bpmn:incoming>Flow_initChecklist_parallelSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_split_waitEdoc</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_creditCheck</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess_edocCollection" name="eDoc collection and validation">
      <bpmn:documentation>Single subprocess: loop Wait → Validate → record verified doc until pendingDocuments is empty, then markEdocsVerified. Message variables: documentType, documentId, documentStatus.</bpmn:documentation>
      <bpmn:incoming>Flow_split_waitEdoc</bpmn:incoming>
      <bpmn:outgoing>Flow_edocSubprocess_join</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_edocSub">
        <bpmn:outgoing>Flow_edocSub_start_wait</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateCatchEvent id="Event_waitEdocUpload" name="Wait for eDoc Upload">
        <bpmn:incoming>Flow_edocSub_start_wait</bpmn:incoming>
        <bpmn:incoming>Flow_notifyIssue_backToWaitEdoc</bpmn:incoming>
        <bpmn:incoming>Flow_allDocs_waitMore</bpmn:incoming>
        <bpmn:outgoing>Flow_waitEdoc_validate</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_edocUpload" messageRef="Message_eDocUploaded" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="Task_validateDocumentViaEcm" name="Validate Document via ECM (Alfresco/OnBase)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="validateDocumentViaEcm" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="integration" value="rest" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_waitEdoc_validate</bpmn:incoming>
        <bpmn:outgoing>Flow_validate_documentGateway</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="BoundaryError_ecmUnavailable" name="ECM unavailable" attachedToRef="Task_validateDocumentViaEcm">
        <bpmn:outgoing>Flow_ecmError_notify</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_ecmUnavailable" errorRef="Error_ecmServiceUnavailable" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="BoundaryTimer_ecmTimeout" name="ECM validation timeout" attachedToRef="Task_validateDocumentViaEcm">
        <bpmn:outgoing>Flow_ecmTimeout_notify</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_ecmTimeout">
          <bpmn:timeDuration>=duration("PT10M")</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Gateway_documentValid" name="Document compliant?" default="Flow_documentInvalid_notify">
        <bpmn:incoming>Flow_validate_documentGateway</bpmn:incoming>
        <bpmn:outgoing>Flow_documentValid_record</bpmn:outgoing>
        <bpmn:outgoing>Flow_documentInvalid_notify</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_documentValid_record" name="Valid" sourceRef="Gateway_documentValid" targetRef="Task_recordDocumentVerified">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentValid</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_documentInvalid_notify" name="Invalid or missing" sourceRef="Gateway_documentValid" targetRef="Task_notifyAdvisorDocumentIssue" />
      <bpmn:serviceTask id="Task_recordDocumentVerified" name="Record document verified">
        <bpmn:documentation>Moves documentType from pendingDocuments to verifiedDocuments for this upload.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="recordDocumentVerified" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_documentValid_record</bpmn:incoming>
        <bpmn:outgoing>Flow_record_allDocsGateway</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_allDocumentsVerified" name="All required docs?" default="Flow_allDocs_waitMore">
        <bpmn:incoming>Flow_record_allDocsGateway</bpmn:incoming>
        <bpmn:outgoing>Flow_allDocs_complete</bpmn:outgoing>
        <bpmn:outgoing>Flow_allDocs_waitMore</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_record_allDocsGateway" sourceRef="Task_recordDocumentVerified" targetRef="Gateway_allDocumentsVerified" />
      <bpmn:sequenceFlow id="Flow_allDocs_complete" name="Complete" sourceRef="Gateway_allDocumentsVerified" targetRef="Task_markEdocsVerified">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(pendingDocuments) = 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_allDocs_waitMore" name="More pending" sourceRef="Gateway_allDocumentsVerified" targetRef="Event_waitEdocUpload" />
      <bpmn:serviceTask id="Task_markEdocsVerified" name="eDocs Verified">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="markEdocsVerified" />
          <zeebe:taskHeaders>
            <zeebe:header key="integration" value="rest" />
            <zeebe:header key="targetStatus" value="eDocs Verified" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_allDocs_complete</bpmn:incoming>
        <bpmn:outgoing>Flow_markVerified_subEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_notifyAdvisorDocumentIssue" name="Send Notification to Advisor">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notifyAdvisorDocumentIssue" />
          <zeebe:taskHeaders>
            <zeebe:header key="integration" value="rest" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_documentInvalid_notify</bpmn:incoming>
        <bpmn:incoming>Flow_ecmError_notify</bpmn:incoming>
        <bpmn:incoming>Flow_ecmTimeout_notify</bpmn:incoming>
        <bpmn:outgoing>Flow_notifyIssue_backToWaitEdoc</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_edocSub">
        <bpmn:incoming>Flow_markVerified_subEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_edocSub_start_wait" sourceRef="StartEvent_edocSub" targetRef="Event_waitEdocUpload" />
      <bpmn:sequenceFlow id="Flow_waitEdoc_validate" sourceRef="Event_waitEdocUpload" targetRef="Task_validateDocumentViaEcm" />
      <bpmn:sequenceFlow id="Flow_validate_documentGateway" sourceRef="Task_validateDocumentViaEcm" targetRef="Gateway_documentValid" />
      <bpmn:sequenceFlow id="Flow_notifyIssue_backToWaitEdoc" sourceRef="Task_notifyAdvisorDocumentIssue" targetRef="Event_waitEdocUpload" />
      <bpmn:sequenceFlow id="Flow_markVerified_subEnd" sourceRef="Task_markEdocsVerified" targetRef="EndEvent_edocSub" />
      <bpmn:subProcess id="SubProcess_edocTimeoutReminder" name="Document wait timeout reminder" triggeredByEvent="true">
        <bpmn:startEvent id="StartEvent_edocTimeoutTimer" name="Document wait timeout" isInterrupting="false">
          <bpmn:outgoing>Flow_edocTimeout_start_notify</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_edocTimeoutSub">
            <bpmn:timeDuration>=duration("P7D")</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Task_notifyAdvisorDocumentTimeout" name="Notify Advisor Document Timeout">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="notifyAdvisorDocumentTimeout" />
            <zeebe:taskHeaders>
              <zeebe:header key="integration" value="rest" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_edocTimeout_start_notify</bpmn:incoming>
          <bpmn:outgoing>Flow_edocTimeout_notify_end</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="EndEvent_edocTimeoutReminder">
          <bpmn:incoming>Flow_edocTimeout_notify_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_edocTimeout_start_notify" sourceRef="StartEvent_edocTimeoutTimer" targetRef="Task_notifyAdvisorDocumentTimeout" />
        <bpmn:sequenceFlow id="Flow_edocTimeout_notify_end" sourceRef="Task_notifyAdvisorDocumentTimeout" targetRef="EndEvent_edocTimeoutReminder" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_triggerCreditCheckAndAml" name="Trigger Credit Check &#38; AML Screening">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triggerCreditCheckAndAml" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="grpc" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_creditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_creditCheck_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_creditHardDecline" name="Credit hard decline" attachedToRef="Task_triggerCreditCheckAndAml">
      <bpmn:outgoing>Flow_creditError_recordManual</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_creditHardDecline" errorRef="Error_creditHardDecline" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryTimer_creditTimeout" name="Credit check timeout" attachedToRef="Task_triggerCreditCheckAndAml">
      <bpmn:outgoing>Flow_creditTimeout_recordManual</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_creditTimeout">
        <bpmn:timeDuration>=duration("PT15M")</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_prepareCreditTimeoutReferral" name="Prepare credit timeout referral">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepareCreditTimeoutReferral" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_creditTimeout_recordManual</bpmn:incoming>
      <bpmn:outgoing>Flow_creditTimeout_prepareRecord</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_recordCreditFailureForManualReview" name="Record credit failure for manual review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="recordCreditFailureForManualReview" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_creditError_recordManual</bpmn:incoming>
      <bpmn:incoming>Flow_creditTimeout_prepareRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_creditFailure_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_creditPathMerge" name="Credit path complete" default="Flow_creditMerged_join">
      <bpmn:documentation>Merges successful credit check and credit-failure referral before parallel join (join must have exactly two branches from the split).</bpmn:documentation>
      <bpmn:incoming>Flow_creditCheck_join</bpmn:incoming>
      <bpmn:incoming>Flow_creditFailure_join</bpmn:incoming>
      <bpmn:outgoing>Flow_creditMerged_join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_parallelJoin" name="Join eDocs / Credit">
      <bpmn:incoming>Flow_edocSubprocess_join</bpmn:incoming>
      <bpmn:incoming>Flow_creditMerged_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_riskAssessment</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Task_automatedRiskAssessment" name="Automated Risk Assessment">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="automated_risk_assessment" resultVariable="riskDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_riskAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_riskAssessment_gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_riskDecision" name="Auto or manual?" default="Flow_riskManual_review">
      <bpmn:incoming>Flow_riskAssessment_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_riskAuto_approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_riskManual_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_riskAuto_approve" name="Auto approve" sourceRef="Gateway_riskDecision" targetRef="Task_updateStatusAutoApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskDecision = "AUTO_APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_riskManual_review" name="Manual review" sourceRef="Gateway_riskDecision" targetRef="Task_manualUnderwritingReview" />
    <bpmn:serviceTask id="Task_updateStatusAutoApproved" name="Application Approved (Auto)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="updateApplicationStatus" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="rest" />
          <zeebe:header key="targetStatus" value="APPROVAL" />
          <zeebe:header key="approvalPath" value="AUTO" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_riskAuto_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_autoApproved_waitEsign</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_manualUnderwritingReview" name="Manual Underwriting Review">
      <bpmn:documentation>Underwriter completes task with underwritingDecision = APPROVED or REJECTED.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manual_underwriting_review_form" />
        <zeebe:assignmentDefinition candidateGroups="Bank Underwriter" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_riskManual_review</bpmn:incoming>
      <bpmn:outgoing>Flow_manualReview_decisionGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryTimer_underwritingSla" name="Underwriting SLA 48h" cancelActivity="false" attachedToRef="Task_manualUnderwritingReview">
      <bpmn:outgoing>Flow_underwritingSla_escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_underwritingSla">
        <bpmn:timeDuration>=duration("PT48H")</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_escalateUnderwritingReview" name="Escalate Underwriting Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalateUnderwritingReview" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="rest" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_underwritingSla_escalate</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_underwritingDecision" name="Underwriting outcome" default="Flow_underwritingRejected">
      <bpmn:incoming>Flow_manualReview_decisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_underwritingApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_underwritingRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_underwritingApproved" name="Approved" sourceRef="Gateway_underwritingDecision" targetRef="Task_updateStatusManualApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=underwritingDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_underwritingRejected" name="Rejected" sourceRef="Gateway_underwritingDecision" targetRef="Task_handleUnderwritingRejection" />
    <bpmn:serviceTask id="Task_updateStatusManualApproved" name="Application Approved (Manual)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="updateApplicationStatus" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="rest" />
          <zeebe:header key="targetStatus" value="APPROVAL" />
          <zeebe:header key="approvalPath" value="MANUAL" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_underwritingApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_manualApproved_waitEsign</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_handleUnderwritingRejection" name="Handle Underwriting Rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handleUnderwritingRejection" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="rest" />
          <zeebe:header key="targetStatus" value="REJECTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_underwritingRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_waitEsignCompleted" name="eSign Completed">
      <bpmn:incoming>Flow_autoApproved_waitEsign</bpmn:incoming>
      <bpmn:incoming>Flow_manualApproved_waitEsign</bpmn:incoming>
      <bpmn:outgoing>Flow_esign_coreBanking</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_esign" messageRef="Message_eSignCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_coreBankingFunding" name="Core Banking Funding Orchestration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="coreBankingFundingOrchestration" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="jms" />
          <zeebe:header key="targetStatus" value="FUNDING" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_esign_coreBanking</bpmn:incoming>
      <bpmn:outgoing>Flow_funding_notifyAdvisor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_fundingFailed" name="Funding failed" attachedToRef="Task_coreBankingFunding">
      <bpmn:outgoing>Flow_fundingError_compensate</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_fundingFailed" errorRef="Error_fundingFailed" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SubProcess_fundingCompensation" name="Funding failure compensation">
      <bpmn:incoming>Flow_fundingError_compensate</bpmn:incoming>
      <bpmn:startEvent id="StartEvent_compensation">
        <bpmn:outgoing>Flow_comp_start_revoke</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_compensateRevokeApproval" name="Compensate revoke approval">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="compensateRevokeApproval" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_comp_start_revoke</bpmn:incoming>
        <bpmn:outgoing>Flow_comp_revoke_releaseEdoc</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_compensateReleaseEdocHold" name="Compensate release eDoc hold">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="compensateReleaseEdocHold" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_comp_revoke_releaseEdoc</bpmn:incoming>
        <bpmn:outgoing>Flow_comp_release_notify</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_notifyAdvisorFundingFailed" name="Notify advisor funding failed">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notifyAdvisorFundingFailed" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_comp_release_notify</bpmn:incoming>
        <bpmn:outgoing>Flow_comp_notify_end</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_fundingFailed" name="Application funding failed">
        <bpmn:incoming>Flow_comp_notify_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_comp_start_revoke" sourceRef="StartEvent_compensation" targetRef="Task_compensateRevokeApproval" />
      <bpmn:sequenceFlow id="Flow_comp_revoke_releaseEdoc" sourceRef="Task_compensateRevokeApproval" targetRef="Task_compensateReleaseEdocHold" />
      <bpmn:sequenceFlow id="Flow_comp_release_notify" sourceRef="Task_compensateReleaseEdocHold" targetRef="Task_notifyAdvisorFundingFailed" />
      <bpmn:sequenceFlow id="Flow_comp_notify_end" sourceRef="Task_notifyAdvisorFundingFailed" targetRef="EndEvent_fundingFailed" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_notifyAdvisorFunded" name="Notify Advisor Funded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notifyAdvisorFunded" />
        <zeebe:taskHeaders>
          <zeebe:header key="integration" value="rest" />
          <zeebe:header key="targetStatus" value="FUNDED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_funding_notifyAdvisor</bpmn:incoming>
      <bpmn:outgoing>Flow_funded_end</bpmn:outgoing>
