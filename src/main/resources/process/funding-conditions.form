{
  "components": [
    {
      "type": "text",
      "id": "Field_funding_conditions_form_T",
      "text": "## Clear funding conditions\nFunding readiness is on HOLD. Update the preconditions below and complete to re-run the check.",
      "layout": {
        "row": "Row_1"
      }
    },
    {
      "type": "textfield",
      "id": "Field_funding_conditions_form_F1",
      "key": "fundingReadiness.reason",
      "label": "Hold reason",
      "readonly": true,
      "layout": {
        "row": "Row_2"
      }
    },
    {
      "type": "number",
      "id": "Field_funding_conditions_form_F2",
      "key": "outstandingConditions",
      "label": "Outstanding approval conditions",
      "validate": {
        "required": true,
        "min": 0
      },
      "layout": {
        "row": "Row_3"
      }
    },
    {
      "type": "checkbox",
      "id": "Field_funding_conditions_form_F3",
      "key": "insuranceConfirmed",
      "label": "Mortgage default insurance confirmed (CMHC / Sagen / Canada Guaranty)",
      "layout": {
        "row": "Row_4"
      }
    },
    {
      "type": "checkbox",
      "id": "Field_funding_conditions_form_F4",
      "key": "fundingHold",
      "label": "Keep funding on hold",
      "layout": {
        "row": "Row_5"
      }
    },
    {
      "type": "textarea",
      "id": "Field_funding_conditions_form_F5",
      "key": "fundingConditionNotes",
      "label": "Notes",
      "layout": {
        "row": "Row_6"
      }
    }
  ],
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  },
  "schemaVersion": 18,
  "id": "funding_conditions_form"
}
